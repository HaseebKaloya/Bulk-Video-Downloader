# 1. Tauri & Rust Compilation Artifacts
src-tauri/target/
target/
**/*.rs.bk

# 2. Large External Binaries (>100MB GitHub limit) & Release Packages
src-tauri/bin/*.exe
bin/*.exe
releases/
backup_unused_files/
*.exe
*.msi
*.zip
*.tar.gz
*.7z
*.rar
*.pdb
*.dll

# 3. Node Dependencies & Frontend Build Output
node_modules/
dist/
dist-ssr/
*.local
.npm/
.eslintcache

# 4. Logs & Debug Records
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Local Application State & Transient Download Files
*.bvd-partial
*.part
*.ytdl
*.sqlite-wal
*.sqlite-shm

# 6. Environment & Secret Configuration
.env
.env.*
!.env.example

# 7. Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*.user
